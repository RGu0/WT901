#!/usr/bin/env bash
# Governed WT901 command entrypoint for macOS and Linux.
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
uv_bin="${UV_BIN:-}"

if [ -z "$uv_bin" ]; then
    uv_bin="$(command -v uv 2>/dev/null || true)"
fi
if [ -z "$uv_bin" ] || [ ! -x "$uv_bin" ]; then
    echo "uv is required; install it as a device bootstrap prerequisite." >&2
    exit 127
fi

# An explicit path bypasses uv centralized project environments. Clear inherited
# legacy settings; uv then uses its cache-backed environment when supported and
# an isolated Worktree .venv when the preview feature is unavailable.
unset UV_PROJECT_ENVIRONMENT
if [[ ",${UV_PREVIEW_FEATURES:-}," != *,centralized-project-envs,* ]]; then
    export UV_PREVIEW_FEATURES="${UV_PREVIEW_FEATURES:+${UV_PREVIEW_FEATURES},}centralized-project-envs"
fi
cd "$project_root"

sync() {
    "$uv_bin" sync --locked --extra dev "$@"
}

action="${1:-}"
shift || true
case "$action" in
    setup)
        [ "$#" -eq 0 ] || { echo "setup accepts no arguments" >&2; exit 2; }
        sync
        ;;
    test)
        [ "$#" -eq 0 ] || { echo "test accepts no arguments" >&2; exit 2; }
        sync
        "$uv_bin" run --locked --extra dev python -m pytest
        ;;
    lint)
        [ "$#" -eq 0 ] || { echo "lint accepts no arguments" >&2; exit 2; }
        sync
        "$uv_bin" run --locked --extra dev ruff check .
        "$uv_bin" run --locked --extra dev mypy src
        ;;
    build)
        [ "$#" -eq 0 ] || { echo "build accepts no arguments" >&2; exit 2; }
        sync
        "$uv_bin" run --locked --extra dev python -m compileall -q src
        ;;
    run)
        [ "$#" -gt 0 ] || { echo "run requires a command" >&2; exit 2; }
        sync
        "$uv_bin" run --locked --extra dev "$@"
        ;;
    *)
        echo "usage: ./dev {setup|test|lint|build|run <command...>}" >&2
        exit 2
        ;;
esac
